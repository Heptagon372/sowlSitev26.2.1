# apps/api/.env 로 복사해 사용한다. .env 는 절대 커밋하지 않는다.

DATABASE_URL="postgresql://sowl:sowl@localhost:5432/sowl?schema=public"
PORT=3001
WEB_ORIGIN="http://localhost:5173"
NODE_ENV=development

# --- 인증 (설계도 ②) ---
# 랜덤 64자 이상 — node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
ACCESS_TOKEN_TTL="30m"
REFRESH_TOKEN_TTL="14d"

# DB 2차 비밀번호 (§8) — 서버 구동 환경변수로만 설정 가능.
# 웹에서 조회·변경 불가. 비어 있으면 서버가 부팅에 실패한다.
DB_ACCESS_PASSPHRASE=""

# 최초 관리자 — 첫 기동(또는 가입) 시 해당 학번 계정을 ADMIN으로 승격
BOOTSTRAP_ADMIN_STUDENT_ID=""

# 로그 IP 해시용 솔트 (랜덤 32자 이상) — production에서는 필수
IP_HASH_SALT=""

# 자료실 업로드 경로 (기본: apps/api/uploads)
# UPLOAD_DIR=""

# --- 3차 선택 기능 ---
# S.OWL AI — 없으면 동아리 자료 '검색 전용'으로 동작한다 (기능 자체는 켜짐)
ANTHROPIC_API_KEY=""

# GitHub 연동 — 없으면 비인증 한도(시간당 60회)로 동작한다
GITHUB_TOKEN=""
